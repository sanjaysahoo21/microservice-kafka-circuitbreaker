# Application config
APP_PORT=8080

# Kafka & Zookeeper config
KAFKA_VERSION=7.5.0
ZOOKEEPER_PORT=2181
KAFKA_INTERNAL_PORT=9092
KAFKA_EXTERNAL_PORT=9093
KAFKA_TOPIC_INVOICE_PROCESSING=invoice_processing_events
KAFKA_CONSUMER_GROUP_ID=invoice-processing-group

# Environment variables for the Spring Boot application
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
CIRCUIT_BREAKER_FAILURE_RATE_THRESHOLD=50
CIRCUIT_BREAKER_WAIT_DURATION_IN_OPEN_STATE_SECONDS=10
CIRCUIT_BREAKER_PERMITTED_CALLS_IN_HALF_OPEN_STATE=1
